# Public frontend build-time values: use the SAME existing Supabase project.
# Set these in Render's Environment settings, then deploy a NEW BUILD after changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put database passwords, service_role, sb_secret keys or seed credentials here.
# admin-users ALLOWED_ORIGINS and privileged keys stay in Supabase Edge Function secrets.
