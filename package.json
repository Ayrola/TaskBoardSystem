{
  "name": "taskboard",
  "version": "1.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed-classroom.js",
    "seed:dry": "node scripts/seed-classroom.js --dry-run",
    "seed:loadtest": "node scripts/seed-loadtest.js --confirm-dev",
    "seed:loadtest:dry": "node scripts/seed-loadtest.js --dry-run",
    "seed:loadtest:cleanup": "node scripts/seed-loadtest.js --cleanup --confirm-dev",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "test:assignees": "node scripts/test-task-assignees.mjs",
    "test:labels": "node scripts/test-project-labels.mjs",
    "test:deadlines": "node scripts/test-deadlines.mjs",
    "test:checklists": "node scripts/test-checklists.mjs",
    "test:activity": "node scripts/test-activity.mjs",
    "test:board": "node scripts/test-board-filters.mjs",
    "test:board:browser": "node scripts/test-board-browser.mjs",
    "test:sidebar:browser": "BOARD_CHECK_SIDEBAR=1 node scripts/test-board-browser.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:theme:browser": "BOARD_CHECK_THEME=1 node scripts/test-board-browser.mjs",
    "test:projects": "node scripts/test-project-browser.mjs",
    "test:projects:browser": "BOARD_CHECK_PROJECTS=1 node scripts/test-board-browser.mjs",
    "test:dashboard:browser": "BOARD_CHECK_DASHBOARD=1 node scripts/test-board-browser.mjs",
    "test:cards:browser": "BOARD_CHECK_CARDS=1 node scripts/test-board-browser.mjs",
    "test:context:browser": "BOARD_CHECK_CONTEXT=1 node scripts/test-board-browser.mjs",
    "test:context": "node scripts/test-project-navigation.mjs && node --experimental-vm-modules scripts/test-project-context.mjs",
    "test:task-form": "node scripts/test-task-form.mjs",
    "test:task-form:browser": "BOARD_CHECK_FORM=1 node scripts/test-board-browser.mjs",
    "test:stages": "node scripts/test-project-stages.mjs",
    "test:stages:browser": "BOARD_CHECK_STAGES=1 node scripts/test-board-browser.mjs",
    "test:project-dashboard": "node scripts/test-project-dashboard.mjs",
    "test:reports": "node scripts/test-report-metrics.mjs && node scripts/test-report-data.mjs",
    "test:reports:browser": "BOARD_CHECK_PDF=1 node scripts/test-board-browser.mjs",
    "reports:samples": "node scripts/generate-report-samples.mjs",
    "test:priority": "node scripts/test-task-priority.mjs && node scripts/test-priority-filters.mjs",
    "test:priority:browser": "BOARD_CHECK_PRIORITY=1 node scripts/test-board-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Trello-style project, stage and task manager",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "4.6.1",
    "dompurify": "3.4.17",
    "pdfmake": "0.3.13",
    "quill": "2.0.3",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "vite": "^8.3.5"
  }
}
